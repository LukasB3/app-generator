#!/usr/bin/env bash
# Root-owned launcher for job containers. The orchestrator may run this through
# sudo and nothing else, so the web-facing process never touches the Docker
# socket. It accepts an action and a job id; every other detail of the
# containers is fixed here and in the root-owned config file.
#
#   ag-sandbox run <job-id>     stdin: the job token, then the job's token for
#                               the database tools or "-", then the prompt
#   ag-sandbox try <job-id>     the same, with the image and the model that are
#                               on trial. For eval runs: this is how a candidate
#                               is measured before the website gets it
#   ag-sandbox render <job-id>  stdin: the checked app as one JSON document;
#                               stdout: what a browser made of it
#   ag-sandbox kill <job-id>
set -euo pipefail
PATH=/usr/sbin:/usr/bin:/sbin:/bin

conf=/etc/app-generator/sandbox.conf
trial=/etc/app-generator/sandbox-trial.conf
docker=/usr/bin/docker
if [[ $EUID -ne 0 ]]; then
  # Test hooks. Ignored when running as root, which is how sudo runs it.
  conf=${PG_SANDBOX_CONF:-$conf}
  trial=${PG_TRIAL_CONF:-$trial}
  docker=${PG_DOCKER:-$docker}
fi

die() {
  echo "ag-sandbox: $1" >&2
  exit 64
}

[[ $# -eq 2 ]] || die "usage: ag-sandbox run|try|render|kill <job-id>"
action=$1
id=$2
[[ $id =~ ^[a-z2-7]{20}$ ]] || die "invalid job id"

# shellcheck source=/dev/null
source "$conf"

case $action in
kill)
  "$docker" kill "ag-job-$id" >/dev/null 2>&1 || true
  "$docker" kill "ag-render-$id" >/dev/null 2>&1 || true
  ;;
render)
  # The browser that opens a checked app. It is handed nothing but the app:
  # no token, no network, no mount, and a user that owns nothing on the host.
  exec "$docker" run --rm -i \
    --name "ag-render-$id" \
    --network none \
    --runtime "$RENDER_RUNTIME" \
    --user 65534:65534 \
    --read-only \
    --cap-drop ALL \
    --security-opt no-new-privileges \
    --pids-limit "$RENDER_PIDS" \
    --memory "$RENDER_MEMORY" \
    --memory-swap "$RENDER_MEMORY" \
    --cpus "$RENDER_CPUS" \
    --tmpfs "/tmp:rw,nosuid,nodev,size=256m,uid=65534,gid=65534" \
    --env HOME=/tmp \
    "$RENDER_IMAGE"
  ;;
run | try)
  if [[ $action == try ]]; then
    [[ -f $trial && ! -L $trial ]] || die "nothing is on trial"
    # Two settings may differ from the website's, and no others, whatever else the file says.
    IMAGE=$(unset IMAGE && source "$trial" && printf '%s' "${IMAGE:-}")
    MODEL=$(unset MODEL && source "$trial" && printf '%s' "${MODEL:-}")
    [[ -n $IMAGE && -n $MODEL ]] || die "the trial names no image or no model"
  fi
  IFS= read -r token || die "missing token"
  [[ $token =~ ^pgj1\.[a-z2-7]{20}\.[0-9]{1,12}\.[a-f0-9]{64}$ && $token == "pgj1.$id."* ]] || die "invalid token"
  # Without a database the orchestrator sends "-", which opens nothing.
  IFS= read -r gate || die "missing database token"
  [[ $gate == - || $gate =~ ^agd1\.[a-z2-7]{20}\.$id\.[0-9]{1,12}\.[a-f0-9]{64}$ ]] || die "invalid database token"

  workspace=$JOBS_DIR/$id
  [[ -d $workspace && ! -L $workspace ]] || die "workspace missing"
  uid=$(id -u "$RUN_AS")
  gid=$(id -g "$RUN_AS")
  [[ $(stat -c %u "$workspace") == "$uid" ]] || die "workspace has the wrong owner"

  # Passed by name below, so the tokens never appear on a command line.
  export ANTHROPIC_API_KEY=$token
  export AG_DB_TOKEN=$gate
  exec "$docker" run --rm -i \
    --name "ag-job-$id" \
    --network "$NETWORK" \
    --runtime "$RUNTIME" \
    --user "$uid:$gid" \
    --read-only \
    --cap-drop ALL \
    --security-opt no-new-privileges \
    --pids-limit "$PIDS" \
    --memory "$MEMORY" \
    --memory-swap "$MEMORY" \
    --cpus "$CPUS" \
    --tmpfs "/tmp:rw,nosuid,nodev,size=64m,uid=$uid,gid=$gid" \
    --tmpfs "/home/agent:rw,nosuid,nodev,size=64m,uid=$uid,gid=$gid" \
    --mount "type=bind,source=$workspace,target=/workspace" \
    --workdir /workspace \
    --env HOME=/home/agent \
    --env "ANTHROPIC_BASE_URL=$PROXY_URL" \
    --env ANTHROPIC_API_KEY \
    --env AG_DB_TOKEN \
    --env "ANTHROPIC_MODEL=$MODEL" \
    "$IMAGE"
  ;;
*)
  die "unknown action"
  ;;
esac

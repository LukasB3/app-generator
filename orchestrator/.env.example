# Required
WEB_ORIGIN=https://app-generator.lukasbossert.com
TURNSTILE_SECRET=
IP_HASH_SECRET=        # 32+ random characters
PROXY_SIGNING_SECRET=  # 32+ random characters, same value in the proxy's environment

# Optional, defaults in src/config.ts
# AGENT_MODEL=claude-sonnet-5-5
# PROXY_URL=http://127.0.0.1:8788   # key proxy as seen from the host, used to screen prompts
# SCREEN_MODEL=claude-haiku-5-5     # must be on the proxy's ALLOWED_MODELS
# JOB_TIMEOUT_S=600
# JOBS_PER_IP_PER_HOUR=3
# JOBS_PER_HOUR=10
# JOBS_PER_DAY=30
# QUEUE_MAX=10
# API_ORIGIN=https://api.app-generator.example   # where this API is reached from outside; published apps with live data ask there
# GATE_URL=http://127.0.0.1:8789   # database gateway as seen from the host
# GATE_SIGNING_SECRET=              # 32+ random characters, same value in the gateway's environment; without it the gateway is not used
